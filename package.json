{
  "name": "breakword",
  "version": "2.1.0",
  "description": "Get the character index where a word must be broken to fit within a given display width.",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "regen:unicode": "node tools/gen-wide.mjs",
    "check:unicode": "node tools/gen-wide.mjs --check",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecfu/breakword.git"
  },
  "keywords": [
    "wordbreak",
    "break-word",
    "textwrap"
  ],
  "author": "tecfu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tecfu/breakword/issues"
  },
  "homepage": "https://github.com/tecfu/breakword#readme"
}
