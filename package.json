{
  "name": "breakword",
  "version": "1.0.8",
  "description": "Get the character index where a word must be broken to fit within a given display width.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecfu/breakword.git"
  },
  "keywords": [
    "wordbreak",
    "break-word",
    "textwrap"
  ],
  "author": "tecfu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tecfu/breakword/issues"
  },
  "homepage": "https://github.com/tecfu/breakword#readme",
  "dependencies": {
    "wcwidth": "^1.0.1"
  }
}
